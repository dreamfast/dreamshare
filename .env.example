# Names only. Real values live in the process environment or a secret store,
# never in git. Copy to .env for docker compose, which gitignores it.

APP_ENV=dev
LISTEN_ON=:8080

# docker publish address, what host interface and port the container is
# exposed on. loopback by default so nothing is public until you say so.
# point BIND_HOST at a private interface when a reverse proxy on another
# box reaches the app through it
BIND_HOST=127.0.0.1
BIND_PORT=8080

# links are built from this, https is enforced in prod
BASE_URL=

# local disk, never a network mount. absolute in prod, it is the /data volume
SQLITE_PATH=data/dreamshare.db

# behind cloudflare or caddy this must be true, with only the proxy ranges
# trusted. otherwise every client ip is spoofable.
BEHIND_PROXY=false
TRUSTED_PROXIES=

# full keeps exact admin drill down and blocking, truncated stores less
IP_MODE=full

# required is the fail closed default, disabled is the dev default
TURNSTILE_MODE=disabled
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# abuse strikes inside one hour before the ip is auto blocked, and how
# long the block holds. admin made blocks are permanent, these are not.
# strikes 0 disables the auto block entirely
AUTOBLOCK_STRIKES=10
AUTOBLOCK_HOURS=24

# true only when cloudflare actually fronts the origin, then the
# CF-Connecting-IP header is trusted for rate limits and blocks. the
# header is honoured only when the proxy chain shows a cloudflare edge,
# a forged header from a direct origin visitor counts against the forger.
# leave false behind a plain reverse proxy
CLOUDFLARE_FRONTED=false

# optional, replaces the built-in cloudflare edge range list. set it only
# when cloudflare announces a range this binary predates, a partial list
# narrows the gate. 0.0.0.0/0 or ::/0 is refused at boot
# CLOUDFLARE_RANGES=

# bucket scoped read and write key with the f/ name prefix
B2_ENDPOINT=http://localhost:9000
B2_REGION=us-west-002
B2_BUCKET=dreamshare
B2_KEY_ID=
B2_APPLICATION_KEY=

# the deep health check asserts the bucket really has these
B2_LIFECYCLE_HIDE_DAYS=9
B2_LIFECYCLE_DELETE_DAYS=1

# smtp2go: mail.smtp2go.com port 587, user is the smtp2go username,
# password is the smtp2go api password, from must be a verified sender
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_FROM=

# enforced before the login handler, so a stray ip never reaches a password
# check. ADMIN_ALLOWLIST_DISABLED=true is the shell escape hatch for a lockout.
ADMIN_EMAIL=
ADMIN_ALLOWLIST=
ADMIN_ALLOWLIST_DISABLED=false
ADMIN_SESSION_IDLE_MINS=30
ADMIN_SESSION_ABS_MINS=720
ADMIN_LOCKOUT_ATTEMPTS=5
ADMIN_LOCKOUT_MINS=15

# caps, 1 GiB per submission and 5 GB per ip per day by default
MAX_SHARE_BYTES=1073741824
DAILY_IP_BYTES=5368709120
MAX_FILES_PER_SHARE=32
TOMBSTONE_HOURS=24
UPLOAD_SEMAPHORE=8

# b2 rejects parts below 5,000,000 bytes and the frame format fixes the check
# blob at 45 bytes, do not change these without changing the format
CHUNK_MIN_BYTES=5000000
CHUNK_MAX_BYTES=33554432
TITLE_CT_MAX_BYTES=4096
MANIFEST_CT_MAX_BYTES=262144
CHECK_CT_BYTES=45
